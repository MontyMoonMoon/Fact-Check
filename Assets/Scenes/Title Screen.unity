  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Congratulations!\n\nYour placement within the editorial division of The
    Republica Post has been formally confirmed. Your profile has been monitored for
    some time, and your progression in the field has not gone unnoticed. We have
    identified key attributes in your work that mark you as suitable for entry-level
    editorial operations.\r\n\nAs of this transmission, you are granted Level 1 clearance.
    This includes provisional access to curated internal sources, press releases
    approved by the Information Ministry, and a limited archive segment. You are
    to review, verify, and format daily reports into publishable articles for end-of-day
    submission. Timeliness is non-negotiable. Source contact outside approved channels
    is grounds for immediate disciplinary review.\r\n\nYour terminal briefing will
    be waiting upon login. You are expected to begin immediately. Remember: your
    work shapes the truth. The public relies on us to deliver clarity and we rely
    on you to uphold our standard.\r\n\nYou are now part of something larger.\r\nDo
    not disappoint.\r\n\n\u2014 Office of Editorial Compliance\r\n\n"
